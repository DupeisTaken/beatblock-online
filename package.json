{
  "name": "beatblock-together",
  "private": true,
  "version": "0.3.0-alpha.1",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm --filter @bbt/protocol build && node scripts/build-windows.mjs",
    "dev": "node scripts/run-cargo.mjs run --manifest-path companion/Cargo.toml --bin BeatblockTogetherRuntime --",
    "test": "pnpm --filter @bbt/protocol test && node scripts/run-cargo.mjs test --manifest-path companion/Cargo.toml --no-fail-fast",
    "test:stress": "node scripts/run-cargo.mjs test --manifest-path companion/Cargo.toml --test stress --release",
    "benchmark": "node scripts/run-benchmark.mjs",
    "trial": "node scripts/run-trials.mjs",
    "typecheck": "pnpm --filter @bbt/protocol build && node scripts/run-cargo.mjs check --manifest-path companion/Cargo.toml",
    "generate:protocol": "pnpm --filter @bbt/protocol build && node scripts/generate-protocol.mjs",
    "validate:patches": "node scripts/validate-patches.mjs",
    "test:mod": "node scripts/package-mods.mjs && node scripts/validate-patches.mjs && node scripts/test-mod.mjs",
    "test:installer": "powershell -NoProfile -File scripts/test-install-mod.ps1",
    "test:runtime": "node scripts/test-runtime-lifecycle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:mods": "node scripts/package-mods.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
