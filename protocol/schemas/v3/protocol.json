{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatblock-online.local/protocol/v3/protocol.json",
  "title": "Beatblock Online protocol v3",
  "$defs": {
    "Envelope": {
      "additionalProperties": false,
      "type": "object",
      "required": ["version", "type", "sequence", "runTimeUs", "payload"],
      "properties": {
        "version": { "const": 3, "type": "number" },
        "type": { "minLength": 1, "maxLength": 80, "type": "string" },
        "sequence": { "minimum": 0, "type": "integer" },
        "runTimeUs": { "minimum": 0, "type": "integer" },
        "runId": { "minLength": 1, "maxLength": 128, "type": "string" },
        "requestId": { "minLength": 1, "maxLength": 80, "type": "string" },
        "payload": {}
      }
    },
    "ScoreTotals": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "hits",
        "misses",
        "barelies",
        "combo",
        "maxCombo",
        "currentMaxHits",
        "maxHits",
        "mineHits"
      ],
      "properties": {
        "hits": { "minimum": 0, "type": "integer" },
        "misses": { "minimum": 0, "type": "integer" },
        "barelies": { "minimum": 0, "type": "integer" },
        "combo": { "minimum": 0, "type": "integer" },
        "maxCombo": { "minimum": 0, "type": "integer" },
        "currentMaxHits": { "minimum": 0, "type": "integer" },
        "maxHits": { "minimum": 0, "type": "integer" },
        "mineHits": { "minimum": 0, "default": 0, "type": "integer" }
      }
    },
    "ChartFingerprint": {
      "type": "object",
      "required": [
        "hash",
        "packageName",
        "songName",
        "variant",
        "expectedMaxHits",
        "official",
        "transferMode"
      ],
      "properties": {
        "hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
        "packageName": { "minLength": 1, "maxLength": 256, "type": "string" },
        "songName": { "minLength": 1, "maxLength": 256, "type": "string" },
        "variant": { "maxLength": 128, "type": "string" },
        "expectedMaxHits": { "minimum": 1, "type": "integer" },
        "official": { "type": "boolean" },
        "transferMode": {
          "anyOf": [
            { "const": "verify_only", "type": "string" },
            { "const": "host_transfer", "type": "string" }
          ]
        }
      }
    },
    "Rules": {
      "additionalProperties": false,
      "type": "object",
      "required": ["rate", "pauseAllowed", "retryAllowed", "forceStart"],
      "properties": {
        "rate": { "const": 1, "type": "number" },
        "pauseAllowed": { "const": false, "type": "boolean" },
        "retryAllowed": { "const": false, "type": "boolean" },
        "forceStart": { "type": "boolean" }
      }
    },
    "RoomModifiers": {
      "additionalProperties": false,
      "type": "object",
      "required": ["rate", "vfx", "taps", "sides", "barelies", "restartOn"],
      "properties": {
        "rate": {
          "anyOf": [
            { "const": 0.5, "type": "number" },
            { "const": 0.6, "type": "number" },
            { "const": 0.7, "type": "number" },
            { "const": 0.8, "type": "number" },
            { "const": 0.9, "type": "number" },
            { "const": 1, "type": "number" },
            { "const": 1.1, "type": "number" },
            { "const": 1.2, "type": "number" },
            { "const": 1.3, "type": "number" },
            { "const": 1.4, "type": "number" },
            { "const": 1.5, "type": "number" },
            { "const": 1.6, "type": "number" },
            { "const": 1.7, "type": "number" },
            { "const": 1.8, "type": "number" },
            { "const": 1.9, "type": "number" },
            { "const": 2, "type": "number" },
            { "const": 2.1, "type": "number" },
            { "const": 2.2, "type": "number" },
            { "const": 2.3, "type": "number" },
            { "const": 2.4, "type": "number" },
            { "const": 2.5, "type": "number" },
            { "const": 2.6, "type": "number" },
            { "const": 2.7, "type": "number" },
            { "const": 2.8, "type": "number" },
            { "const": 2.9, "type": "number" },
            { "const": 3, "type": "number" },
            { "const": 3.1, "type": "number" },
            { "const": 3.2, "type": "number" },
            { "const": 3.3, "type": "number" },
            { "const": 3.4, "type": "number" },
            { "const": 3.5, "type": "number" },
            { "const": 3.6, "type": "number" },
            { "const": 3.7, "type": "number" },
            { "const": 3.8, "type": "number" },
            { "const": 3.9, "type": "number" },
            { "const": 4, "type": "number" },
            { "const": 4.1, "type": "number" },
            { "const": 4.2, "type": "number" },
            { "const": 4.3, "type": "number" },
            { "const": 4.4, "type": "number" },
            { "const": 4.5, "type": "number" },
            { "const": 4.6, "type": "number" },
            { "const": 4.7, "type": "number" },
            { "const": 4.8, "type": "number" },
            { "const": 4.9, "type": "number" },
            { "const": 5, "type": "number" }
          ]
        },
        "vfx": {
          "anyOf": [
            { "const": "full", "type": "string" },
            { "const": "decreased", "type": "string" },
            { "const": "none", "type": "string" }
          ]
        },
        "taps": {
          "anyOf": [
            { "const": "default", "type": "string" },
            { "const": "lenient", "type": "string" },
            { "const": "strict", "type": "string" },
            { "const": "auto", "type": "string" }
          ]
        },
        "sides": {
          "anyOf": [
            { "const": "default", "type": "string" },
            { "const": "lenient", "type": "string" },
            { "const": "auto", "type": "string" }
          ]
        },
        "barelies": {
          "anyOf": [
            { "const": "default", "type": "string" },
            { "const": "lenient", "type": "string" },
            { "const": "strict", "type": "string" }
          ]
        },
        "restartOn": {
          "anyOf": [
            { "const": "none", "type": "string" },
            { "const": "miss", "type": "string" },
            { "const": "barely", "type": "string" }
          ]
        }
      }
    },
    "PlayerSnapshot": {
      "type": "object",
      "required": [
        "sessionId",
        "displayName",
        "role",
        "admitted",
        "connected",
        "ready",
        "verified",
        "progress",
        "accuracy",
        "setTotal",
        "totals",
        "validity",
        "commentatorAccess"
      ],
      "properties": {
        "sessionId": { "minLength": 1, "type": "string" },
        "displayName": { "minLength": 1, "maxLength": 48, "type": "string" },
        "role": {
          "anyOf": [
            { "const": "player", "type": "string" },
            { "const": "spectator", "type": "string" },
            { "const": "host", "type": "string" }
          ]
        },
        "admitted": { "type": "boolean" },
        "connected": { "type": "boolean" },
        "ready": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "rank": { "minimum": 1, "type": "integer" },
        "progress": { "minimum": 0, "maximum": 1, "type": "number" },
        "accuracy": { "minimum": 0, "maximum": 100, "type": "number" },
        "setTotal": { "minimum": 0, "type": "number" },
        "totals": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "hits",
            "misses",
            "barelies",
            "combo",
            "maxCombo",
            "currentMaxHits",
            "maxHits",
            "mineHits"
          ],
          "properties": {
            "hits": { "minimum": 0, "type": "integer" },
            "misses": { "minimum": 0, "type": "integer" },
            "barelies": { "minimum": 0, "type": "integer" },
            "combo": { "minimum": 0, "type": "integer" },
            "maxCombo": { "minimum": 0, "type": "integer" },
            "currentMaxHits": { "minimum": 0, "type": "integer" },
            "maxHits": { "minimum": 0, "type": "integer" },
            "mineHits": { "minimum": 0, "default": 0, "type": "integer" }
          }
        },
        "validity": {
          "anyOf": [
            { "const": "pending", "type": "string" },
            { "const": "valid", "type": "string" },
            { "const": "invalid", "type": "string" },
            { "const": "dnf", "type": "string" }
          ]
        },
        "invalidReason": { "maxLength": 512, "type": "string" },
        "commentatorAccess": { "default": false, "type": "boolean" }
      }
    },
    "LobbySnapshot": {
      "type": "object",
      "required": [
        "id",
        "name",
        "hostSessionId",
        "lifecycle",
        "admissionMode",
        "allowChartTransfers",
        "participants",
        "forceStart",
        "setlist",
        "createdAtMs",
        "updatedAtMs"
      ],
      "properties": {
        "id": { "minLength": 1, "type": "string" },
        "name": { "minLength": 1, "maxLength": 80, "type": "string" },
        "hostSessionId": { "minLength": 1, "type": "string" },
        "lifecycle": {
          "anyOf": [
            { "const": "forming", "type": "string" },
            { "const": "chart_locked", "type": "string" },
            { "const": "ready", "type": "string" },
            { "const": "countdown", "type": "string" },
            { "const": "playing", "type": "string" },
            { "const": "results", "type": "string" },
            { "const": "set_complete", "type": "string" },
            { "const": "closed", "type": "string" }
          ]
        },
        "admissionMode": {
          "anyOf": [
            { "const": "password_only", "type": "string" },
            { "const": "host_approval", "type": "string" }
          ]
        },
        "allowChartTransfers": { "default": true, "type": "boolean" },
        "autoRequestChartTransfers": { "default": false, "type": "boolean" },
        "validityChecksEnabled": { "default": true, "type": "boolean" },
        "requireSameGameBuild": { "default": true, "type": "boolean" },
        "modifiers": {
          "additionalProperties": false,
          "type": "object",
          "required": ["rate", "vfx", "taps", "sides", "barelies", "restartOn"],
          "properties": {
            "rate": {
              "anyOf": [
                { "const": 0.5, "type": "number" },
                { "const": 0.6, "type": "number" },
                { "const": 0.7, "type": "number" },
                { "const": 0.8, "type": "number" },
                { "const": 0.9, "type": "number" },
                { "const": 1, "type": "number" },
                { "const": 1.1, "type": "number" },
                { "const": 1.2, "type": "number" },
                { "const": 1.3, "type": "number" },
                { "const": 1.4, "type": "number" },
                { "const": 1.5, "type": "number" },
                { "const": 1.6, "type": "number" },
                { "const": 1.7, "type": "number" },
                { "const": 1.8, "type": "number" },
                { "const": 1.9, "type": "number" },
                { "const": 2, "type": "number" },
                { "const": 2.1, "type": "number" },
                { "const": 2.2, "type": "number" },
                { "const": 2.3, "type": "number" },
                { "const": 2.4, "type": "number" },
                { "const": 2.5, "type": "number" },
                { "const": 2.6, "type": "number" },
                { "const": 2.7, "type": "number" },
                { "const": 2.8, "type": "number" },
                { "const": 2.9, "type": "number" },
                { "const": 3, "type": "number" },
                { "const": 3.1, "type": "number" },
                { "const": 3.2, "type": "number" },
                { "const": 3.3, "type": "number" },
                { "const": 3.4, "type": "number" },
                { "const": 3.5, "type": "number" },
                { "const": 3.6, "type": "number" },
                { "const": 3.7, "type": "number" },
                { "const": 3.8, "type": "number" },
                { "const": 3.9, "type": "number" },
                { "const": 4, "type": "number" },
                { "const": 4.1, "type": "number" },
                { "const": 4.2, "type": "number" },
                { "const": 4.3, "type": "number" },
                { "const": 4.4, "type": "number" },
                { "const": 4.5, "type": "number" },
                { "const": 4.6, "type": "number" },
                { "const": 4.7, "type": "number" },
                { "const": 4.8, "type": "number" },
                { "const": 4.9, "type": "number" },
                { "const": 5, "type": "number" }
              ]
            },
            "vfx": {
              "anyOf": [
                { "const": "full", "type": "string" },
                { "const": "decreased", "type": "string" },
                { "const": "none", "type": "string" }
              ]
            },
            "taps": {
              "anyOf": [
                { "const": "default", "type": "string" },
                { "const": "lenient", "type": "string" },
                { "const": "strict", "type": "string" },
                { "const": "auto", "type": "string" }
              ]
            },
            "sides": {
              "anyOf": [
                { "const": "default", "type": "string" },
                { "const": "lenient", "type": "string" },
                { "const": "auto", "type": "string" }
              ]
            },
            "barelies": {
              "anyOf": [
                { "const": "default", "type": "string" },
                { "const": "lenient", "type": "string" },
                { "const": "strict", "type": "string" }
              ]
            },
            "restartOn": {
              "anyOf": [
                { "const": "none", "type": "string" },
                { "const": "miss", "type": "string" },
                { "const": "barely", "type": "string" }
              ]
            }
          }
        },
        "chart": {
          "type": "object",
          "required": [
            "hash",
            "packageName",
            "songName",
            "variant",
            "expectedMaxHits",
            "official",
            "transferMode"
          ],
          "properties": {
            "hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
            "packageName": { "minLength": 1, "maxLength": 256, "type": "string" },
            "songName": { "minLength": 1, "maxLength": 256, "type": "string" },
            "variant": { "maxLength": 128, "type": "string" },
            "expectedMaxHits": { "minimum": 1, "type": "integer" },
            "official": { "type": "boolean" },
            "transferMode": {
              "anyOf": [
                { "const": "verify_only", "type": "string" },
                { "const": "host_transfer", "type": "string" }
              ]
            }
          }
        },
        "participants": {
          "maxItems": 48,
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sessionId",
              "displayName",
              "role",
              "admitted",
              "connected",
              "ready",
              "verified",
              "progress",
              "accuracy",
              "setTotal",
              "totals",
              "validity",
              "commentatorAccess"
            ],
            "properties": {
              "sessionId": { "minLength": 1, "type": "string" },
              "displayName": { "minLength": 1, "maxLength": 48, "type": "string" },
              "role": {
                "anyOf": [
                  { "const": "player", "type": "string" },
                  { "const": "spectator", "type": "string" },
                  { "const": "host", "type": "string" }
                ]
              },
              "admitted": { "type": "boolean" },
              "connected": { "type": "boolean" },
              "ready": { "type": "boolean" },
              "verified": { "type": "boolean" },
              "rank": { "minimum": 1, "type": "integer" },
              "progress": { "minimum": 0, "maximum": 1, "type": "number" },
              "accuracy": { "minimum": 0, "maximum": 100, "type": "number" },
              "setTotal": { "minimum": 0, "type": "number" },
              "totals": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "hits",
                  "misses",
                  "barelies",
                  "combo",
                  "maxCombo",
                  "currentMaxHits",
                  "maxHits",
                  "mineHits"
                ],
                "properties": {
                  "hits": { "minimum": 0, "type": "integer" },
                  "misses": { "minimum": 0, "type": "integer" },
                  "barelies": { "minimum": 0, "type": "integer" },
                  "combo": { "minimum": 0, "type": "integer" },
                  "maxCombo": { "minimum": 0, "type": "integer" },
                  "currentMaxHits": { "minimum": 0, "type": "integer" },
                  "maxHits": { "minimum": 0, "type": "integer" },
                  "mineHits": { "minimum": 0, "default": 0, "type": "integer" }
                }
              },
              "validity": {
                "anyOf": [
                  { "const": "pending", "type": "string" },
                  { "const": "valid", "type": "string" },
                  { "const": "invalid", "type": "string" },
                  { "const": "dnf", "type": "string" }
                ]
              },
              "invalidReason": { "maxLength": 512, "type": "string" },
              "commentatorAccess": { "default": false, "type": "boolean" }
            }
          }
        },
        "scheduledStartTimeMs": { "minimum": 0, "type": "integer" },
        "forceStart": { "type": "boolean" },
        "setlist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "chart", "completed"],
            "properties": {
              "id": { "type": "string" },
              "chart": {
                "type": "object",
                "required": [
                  "hash",
                  "packageName",
                  "songName",
                  "variant",
                  "expectedMaxHits",
                  "official",
                  "transferMode"
                ],
                "properties": {
                  "hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
                  "packageName": { "minLength": 1, "maxLength": 256, "type": "string" },
                  "songName": { "minLength": 1, "maxLength": 256, "type": "string" },
                  "variant": { "maxLength": 128, "type": "string" },
                  "expectedMaxHits": { "minimum": 1, "type": "integer" },
                  "official": { "type": "boolean" },
                  "transferMode": {
                    "anyOf": [
                      { "const": "verify_only", "type": "string" },
                      { "const": "host_transfer", "type": "string" }
                    ]
                  }
                }
              },
              "completed": { "type": "boolean" }
            }
          }
        },
        "currentSetlistIndex": {
          "anyOf": [{ "minimum": 0, "type": "integer" }, { "type": "null" }]
        },
        "createdAtMs": { "minimum": 0, "type": "integer" },
        "updatedAtMs": { "minimum": 0, "type": "integer" }
      }
    },
    "RunScoreDelta": {
      "type": "object",
      "required": ["runSequence", "progress", "beat", "songTimeMs", "totals"],
      "properties": {
        "runSequence": { "minimum": 0, "type": "integer" },
        "progress": { "minimum": 0, "maximum": 1, "type": "number" },
        "beat": { "type": "number" },
        "songTimeMs": { "type": "integer" },
        "totals": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "hits",
            "misses",
            "barelies",
            "combo",
            "maxCombo",
            "currentMaxHits",
            "maxHits",
            "mineHits"
          ],
          "properties": {
            "hits": { "minimum": 0, "type": "integer" },
            "misses": { "minimum": 0, "type": "integer" },
            "barelies": { "minimum": 0, "type": "integer" },
            "combo": { "minimum": 0, "type": "integer" },
            "maxCombo": { "minimum": 0, "type": "integer" },
            "currentMaxHits": { "minimum": 0, "type": "integer" },
            "maxHits": { "minimum": 0, "type": "integer" },
            "mineHits": { "minimum": 0, "default": 0, "type": "integer" }
          }
        }
      }
    },
    "ClientHello": {
      "type": "object",
      "required": [
        "instanceId",
        "clientVersion",
        "gameVersion",
        "gameBuildId",
        "gameBuildSource",
        "distribution",
        "mods"
      ],
      "properties": {
        "instanceId": { "minLength": 1, "maxLength": 96, "type": "string" },
        "clientVersion": { "minLength": 1, "type": "string" },
        "gameVersion": { "minLength": 1, "maxLength": 160, "type": "string" },
        "gameBuildId": { "minLength": 7, "maxLength": 80, "type": "string" },
        "gameBuildSource": {
          "anyOf": [
            { "const": "displayed_build_hash", "type": "string" },
            { "const": "displayed_version_digest", "type": "string" },
            { "const": "game_content_digest", "type": "string" }
          ]
        },
        "distribution": {
          "anyOf": [
            { "const": "standalone", "type": "string" },
            { "const": "beatblock-plus", "type": "string" }
          ]
        },
        "mods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "hash"],
            "properties": { "id": { "type": "string" }, "hash": { "type": "string" } }
          }
        }
      }
    },
    "BroadcastPlan": {
      "additionalProperties": false,
      "type": "object",
      "required": ["revision", "updatedAtMs", "slots"],
      "properties": {
        "revision": { "minimum": 0, "type": "integer" },
        "updatedAtMs": { "minimum": 0, "type": "integer" },
        "slots": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "mode", "width", "height", "fps", "delayMs", "featured", "active"],
            "properties": {
              "id": {
                "anyOf": [
                  { "const": "A", "type": "string" },
                  { "const": "B", "type": "string" },
                  { "const": "C", "type": "string" },
                  { "const": "D", "type": "string" }
                ]
              },
              "participantId": { "minLength": 1, "type": "string" },
              "participantName": { "minLength": 1, "maxLength": 48, "type": "string" },
              "renderSourceId": { "minimum": 1, "type": "integer" },
              "mode": {
                "anyOf": [
                  { "const": "clean", "type": "string" },
                  { "const": "full", "type": "string" }
                ]
              },
              "width": { "minimum": 320, "maximum": 1920, "type": "integer" },
              "height": { "minimum": 180, "maximum": 1080, "type": "integer" },
              "fps": {
                "anyOf": [
                  { "const": 30, "type": "number" },
                  { "const": 60, "type": "number" }
                ]
              },
              "delayMs": { "minimum": 250, "maximum": 1500, "type": "integer" },
              "featured": { "type": "boolean" },
              "active": { "type": "boolean" }
            }
          }
        },
        "autoplayAudioEnabled": { "type": "boolean" },
        "autoplayClockSlot": {
          "anyOf": [
            { "const": "A", "type": "string" },
            { "const": "B", "type": "string" },
            { "const": "C", "type": "string" },
            { "const": "D", "type": "string" }
          ]
        }
      }
    },
    "CommentatorMirrorStatus": {
      "additionalProperties": false,
      "type": "object",
