{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatblock-together.local/protocol/v1/protocol.json",
  "title": "Beatblock Together direct-host protocol v1",
  "$defs": {
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "sequence", "runTimeUs", "payload"],
      "properties": {
        "version": { "const": 1 },
        "type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sequence": { "type": "integer", "minimum": 0 },
        "runTimeUs": { "type": "integer", "minimum": 0 },
        "runId": { "type": "string", "maxLength": 80 },
        "payload": {}
      }
    },
    "RenderDatagram": {
      "description": "Packed 32-byte little-endian datagram: version:u8, pad:3, session:u32, sequence:u32, runTimeUs:u64, beat:f32, paddleAngle:f32, tapMask:u16, flags:u16",
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 44,
      "maxLength": 44
    },
    "ScoreTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hits",
        "misses",
        "barelies",
        "combo",
        "maxCombo",
        "currentMaxHits",
        "maxHits",
        "mineHits"
      ],
      "properties": {
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 },
        "barelies": { "type": "integer", "minimum": 0 },
        "combo": { "type": "integer", "minimum": 0 },
        "maxCombo": { "type": "integer", "minimum": 0 },
        "currentMaxHits": { "type": "integer", "minimum": 0 },
        "maxHits": { "type": "integer", "minimum": 0 },
        "mineHits": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/Envelope" }, { "$ref": "#/$defs/RenderDatagram" }]
}
