{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatblock-together.local/protocol/v1/protocol.json",
  "title": "Beatblock Together protocol v1",
  "$defs": {
    "Envelope": {
      "additionalProperties": false,
      "type": "object",
      "required": ["version", "type", "sequence", "timestampMs", "payload"],
      "properties": {
        "version": {
          "const": 1,
          "type": "number"
        },
        "type": {
          "minLength": 1,
          "maxLength": 80,
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "timestampMs": {
          "minimum": 0,
          "type": "integer"
        },
        "payload": {}
      }
    },
    "ScoreTotals": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "hits",
        "misses",
        "barelies",
        "combo",
        "maxCombo",
        "currentMaxHits",
        "maxHits",
        "mineHits"
      ],
      "properties": {
        "hits": {
          "minimum": 0,
          "type": "integer"
        },
        "misses": {
          "minimum": 0,
          "type": "integer"
        },
        "barelies": {
          "minimum": 0,
          "type": "integer"
        },
        "combo": {
          "minimum": 0,
          "type": "integer"
        },
        "maxCombo": {
          "minimum": 0,
          "type": "integer"
        },
        "currentMaxHits": {
          "minimum": 0,
          "type": "integer"
        },
        "maxHits": {
          "minimum": 0,
          "type": "integer"
        },
        "mineHits": {
          "minimum": 0,
          "default": 0,
          "type": "integer"
        }
      }
    },
    "ChartFingerprint": {
      "additionalProperties": false,
      "type": "object",
      "required": ["algorithm", "hash", "packageName", "songName", "variant", "expectedMaxHits"],
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-package-v1",
          "type": "string"
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "packageName": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "songName": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "variant": {
          "maxLength": 128,
          "type": "string"
        },
        "expectedMaxHits": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "Rules": {
      "additionalProperties": false,
      "type": "object",
      "required": ["rate", "taps", "sides", "barelies", "pauseAllowed", "retryAllowed"],
      "properties": {
        "rate": {
          "const": 1,
          "type": "number"
        },
        "taps": {
          "const": "default",
          "type": "string"
        },
        "sides": {
          "const": "default",
          "type": "string"
        },
        "barelies": {
          "const": "default",
          "type": "string"
        },
        "pauseAllowed": {
          "const": false,
          "type": "boolean"
        },
        "retryAllowed": {
          "const": false,
          "type": "boolean"
        }
      }
    },
    "PlayerSnapshot": {
      "type": "object",
      "required": [
        "userId",
        "displayName",
        "connected",
        "ready",
        "spectator",
        "progress",
        "accuracy",
        "totals",
        "validity"
      ],
      "properties": {
        "userId": {
          "minLength": 1,
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "maxLength": 48,
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "spectator": {
          "type": "boolean"
        },
        "rank": {
          "minimum": 1,
          "type": "integer"
        },
        "progress": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "accuracy": {
          "minimum": 0,
          "maximum": 100,
          "type": "number"
        },
        "totals": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "hits",
            "misses",
            "barelies",
            "combo",
            "maxCombo",
            "currentMaxHits",
            "maxHits",
            "mineHits"
          ],
          "properties": {
            "hits": {
              "minimum": 0,
              "type": "integer"
            },
            "misses": {
              "minimum": 0,
              "type": "integer"
            },
            "barelies": {
              "minimum": 0,
              "type": "integer"
            },
            "combo": {
              "minimum": 0,
              "type": "integer"
            },
            "maxCombo": {
              "minimum": 0,
              "type": "integer"
            },
            "currentMaxHits": {
              "minimum": 0,
              "type": "integer"
            },
            "maxHits": {
              "minimum": 0,
              "type": "integer"
            },
            "mineHits": {
              "minimum": 0,
              "default": 0,
              "type": "integer"
            }
          }
        },
        "validity": {
          "anyOf": [
            {
              "const": "pending",
              "type": "string"
            },
            {
              "const": "valid",
              "type": "string"
            },
            {
              "const": "invalid",
              "type": "string"
            },
            {
              "const": "dnf",
              "type": "string"
            }
          ]
        },
        "invalidReason": {
          "maxLength": 256,
          "type": "string"
        }
      }
    },
    "LobbySnapshot": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name",
        "organizerId",
        "lifecycle",
        "rules",
        "players",
        "createdAtMs",
        "updatedAtMs"
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "code": {
          "minLength": 6,
          "maxLength": 8,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "maxLength": 80,
          "type": "string"
        },
        "organizerId": {
          "minLength": 1,
          "type": "string"
        },
        "lifecycle": {
          "anyOf": [
            {
              "const": "forming",
              "type": "string"
            },
            {
              "const": "chart_locked",
              "type": "string"
            },
            {
              "const": "ready",
              "type": "string"
            },
            {
              "const": "countdown",
              "type": "string"
            },
            {
              "const": "playing",
              "type": "string"
            },
            {
              "const": "results",
              "type": "string"
            },
            {
              "const": "closed",
              "type": "string"
            }
          ]
        },
        "chart": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "algorithm",
            "hash",
            "packageName",
            "songName",
            "variant",
            "expectedMaxHits"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256-canonical-package-v1",
              "type": "string"
            },
            "hash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "packageName": {
              "minLength": 1,
              "maxLength": 256,
              "type": "string"
            },
            "songName": {
              "minLength": 1,
              "maxLength": 256,
              "type": "string"
            },
            "variant": {
              "maxLength": 128,
              "type": "string"
            },
            "expectedMaxHits": {
              "minimum": 1,
              "type": "integer"
            }
          }
        },
        "rules": {
          "additionalProperties": false,
          "type": "object",
          "required": ["rate", "taps", "sides", "barelies", "pauseAllowed", "retryAllowed"],
          "properties": {
            "rate": {
              "const": 1,
              "type": "number"
            },
            "taps": {
              "const": "default",
              "type": "string"
            },
            "sides": {
              "const": "default",
              "type": "string"
            },
            "barelies": {
              "const": "default",
              "type": "string"
            },
            "pauseAllowed": {
              "const": false,
              "type": "boolean"
            },
            "retryAllowed": {
              "const": false,
              "type": "boolean"
            }
          }
        },
        "players": {
          "maxItems": 48,
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "userId",
              "displayName",
              "connected",
              "ready",
              "spectator",
              "progress",
              "accuracy",
              "totals",
              "validity"
            ],
            "properties": {
              "userId": {
                "minLength": 1,
                "type": "string"
              },
              "displayName": {
                "minLength": 1,
                "maxLength": 48,
                "type": "string"
              },
              "connected": {
                "type": "boolean"
              },
              "ready": {
                "type": "boolean"
              },
              "spectator": {
                "type": "boolean"
              },
              "rank": {
                "minimum": 1,
                "type": "integer"
              },
              "progress": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "accuracy": {
                "minimum": 0,
                "maximum": 100,
                "type": "number"
              },
              "totals": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "hits",
                  "misses",
                  "barelies",
                  "combo",
                  "maxCombo",
                  "currentMaxHits",
                  "maxHits",
                  "mineHits"
                ],
                "properties": {
                  "hits": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "misses": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "barelies": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "combo": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxCombo": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "currentMaxHits": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxHits": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "mineHits": {
                    "minimum": 0,
                    "default": 0,
                    "type": "integer"
                  }
                }
              },
              "validity": {
                "anyOf": [
                  {
                    "const": "pending",
                    "type": "string"
                  },
                  {
                    "const": "valid",
                    "type": "string"
                  },
                  {
                    "const": "invalid",
                    "type": "string"
                  },
                  {
                    "const": "dnf",
                    "type": "string"
                  }
                ]
              },
              "invalidReason": {
                "maxLength": 256,
                "type": "string"
              }
            }
          }
        },
        "scheduledStartTimeMs": {
          "minimum": 0,
          "type": "integer"
        },
        "createdAtMs": {
          "minimum": 0,
          "type": "integer"
        },
        "updatedAtMs": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "RunScoreDelta": {
      "type": "object",
      "required": ["lobbyId", "runId", "runSequence", "progress", "beat", "songTimeMs", "totals"],
      "properties": {
        "lobbyId": {
          "minLength": 1,
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "runSequence": {
          "minimum": 0,
          "type": "integer"
        },
        "progress": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "beat": {
          "type": "number"
        },
        "songTimeMs": {
          "type": "integer"
        },
        "totals": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "hits",
            "misses",
            "barelies",
            "combo",
            "maxCombo",
            "currentMaxHits",
            "maxHits",
            "mineHits"
          ],
          "properties": {
            "hits": {
              "minimum": 0,
              "type": "integer"
            },
            "misses": {
              "minimum": 0,
              "type": "integer"
            },
            "barelies": {
              "minimum": 0,
              "type": "integer"
            },
            "combo": {
              "minimum": 0,
              "type": "integer"
            },
            "maxCombo": {
              "minimum": 0,
              "type": "integer"
            },
            "currentMaxHits": {
              "minimum": 0,
              "type": "integer"
            },
            "maxHits": {
              "minimum": 0,
              "type": "integer"
            },
            "mineHits": {
              "minimum": 0,
              "default": 0,
              "type": "integer"
            }
          }
        }
      }
    },
    "ClientHello": {
      "type": "object",
      "required": ["clientVersion", "gameBuildHash", "distribution", "mods"],
      "properties": {
        "clientVersion": {
          "minLength": 1,
          "type": "string"
        },
        "gameBuildHash": {
          "minLength": 1,
          "type": "string"
        },
        "distribution": {
          "anyOf": [
            {
              "const": "standalone",
              "type": "string"
            },
            {
              "const": "beatblock-plus",
              "type": "string"
            }
          ]
        },
        "mods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "hash"],
            "properties": {
              "id": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
