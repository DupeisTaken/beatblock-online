{
  "name": "@bbt/server",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bbt-server": "dist/index.js",
    "bbtctl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:stress": "vitest run test/stress.test.ts",
    "benchmark": "tsx bench/stress.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bbt/protocol": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "commander": "^14.0.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3"
  }
}
